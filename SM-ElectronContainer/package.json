{
  "name": "sm-electron-container",
  "version": "1.0.0",
  "description": "Visual Novel Engine - Electron Port",
  "main": "dist/main/main.js",
  "scripts": {
    "copy-static": "cp src/renderer/*.html dist/renderer/",
    "copy-content": "cp -r Scenarios Scenes Characters Assets dist/ 2>/dev/null || true",
    "build-renderer": "esbuild src/renderer/main.ts --bundle --outfile=dist/renderer/renderer.js --format=iife --platform=browser --define:exports=undefined",
    "build": "tsc && npm run build-renderer && npm run copy-static && npm run copy-content",
    "start": "npm run build && electron .",
    "dev": "tsc && npm run build-renderer && npm run copy-static && npm run copy-content && electron .",
    "test": "vitest",
    "test:run": "vitest run",
    "pack": "electron-builder --dir"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "electron": "^28.0.0",
    "esbuild": "^0.27.4",
    "typescript": "^5.3.0",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "electron-log": "^5.0.0",
    "pixi.js": "^8.17.1"
  },
  "build": {
    "appId": "com.sm.vnengine",
    "productName": "SM Visual Novel Engine",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ]
  }
}
