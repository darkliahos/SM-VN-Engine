{
  "name": "sm-engine",
  "version": "0.8.0",
  "description": "Visual Novel Engine - Milestone 2",
  "main": "dist/main/main.js",
  "scripts": {
    "copy-assets": "node tools/copy-assets.js",
    "build-renderer": "esbuild src/renderer/main.ts --bundle --outfile=dist/renderer/renderer.js --format=iife --platform=browser --define:exports=undefined",
    "build": "node tools/build.js",
    "start": "node tools/build.js --run",
    "dev": "node tools/build.js --run",
    "test": "vitest",
    "test:run": "vitest run",
    "pack": "node tools/distribute.js --dir",
    "dist": "node tools/distribute.js",
    "distribute": "node tools/distribute.js",
    "distribute:dir": "node tools/distribute.js --dir",
    "pack:fap": "node ../SM-cli/dist/index.js pack"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "@types/node": "^20.10.0",
    "electron": "^41.10.6",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "^5.3.0",
    "vitest": "^4.1.11",
    "yazl": "^3.3.1"
  },
  "dependencies": {
    "electron-log": "^5.0.0",
    "howler": "^2.2.4",
    "pixi.js": "^8.17.1",
    "unzipper": "^0.12.5"
  },
  "build": {
    "appId": "com.sm.vnengine",
    "productName": "SM Visual Novel Engine",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      "Metadata.json",
      "Scripts/**/*",
      "Assets/**/*"
    ]
  }
}
